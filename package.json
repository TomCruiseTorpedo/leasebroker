{
  "name": "leasebroker",
  "version": "0.4.0",
  "description": "Local-first broker that issues time-bounded, narrowly-scoped capability leases to AI agents and MCP servers, instead of standing permissions.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TomCruiseTorpedo/leasebroker.git"
  },
  "bugs": {
    "url": "https://github.com/TomCruiseTorpedo/leasebroker/issues"
  },
  "homepage": "https://github.com/TomCruiseTorpedo/leasebroker#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent",
    "llm",
    "capability",
    "least-privilege",
    "security",
    "lease",
    "authorization",
    "proxy"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "leasebroker": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli/index.js",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:govern-sync": "bash scripts/check-sync-govern.sh",
    "check:govern-cross": "bash scripts/check-sync-govern.sh --cross",
    "test:watch": "vitest",
    "demo": "bun ./scripts/demo.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@noble/ed25519": "^3.1.0",
    "@opentelemetry/api-logs": "^0.220.0",
    "minimatch": "^10.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/server-filesystem": "^2026.8.31",
    "@types/node": "^25.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "hono": "^4.13.7",
    "@hono/node-server": "^1.19.15",
    "fast-uri": "^3.1.8",
    "ip-address": "^10.7.1",
    "qs": "^6.16.0",
    "proxy-addr": "^2.0.8",
    "body-parser": "^2.3.0",
    "nanoid": "^3.3.16",
    "postcss": "^8.5.23",
    "source-map-js": "^1.2.2"
  }
}
